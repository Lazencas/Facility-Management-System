<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.kgt.facility_access_management.user.mapper.UserMapper">

    <select id="findByLoginId"
            resultType="com.kgt.facility_access_management.user.domain.User">


        SELECT
        id,
        login_id,
        password_hash,
        name,
        role,
        active,
        created_at,
        updated_at
        FROM users WHERE login_id = #{loginId}

    </select>

    <select id="findById"
            resultType="com.kgt.facility_access_management.user.domain.User">
        SELECT
        id,
        login_id,
        password_hash,
        name,
        role,
        active,
        created_at,
        updated_at
        FROM users
        WHERE id = #{id}
    </select>

</mapper>